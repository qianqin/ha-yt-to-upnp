# MPD for the receiver and the Raumfeld adapter. Control stays on loopback;
# only the httpd stream (port 8000) is reachable from the LAN.
# ytcast-init writes it to /run/ytcast/mpd.conf at each start, with the encoder
# lines for the stream_format option in place of the placeholder below.
# Loopback is the HA host's loopback (host network); MPD has no password because
# neither the receiver nor the adapter can send one (see DOCS.md).
music_directory     "/data/mpd/music"
playlist_directory  "/data/mpd/playlists"
db_file             "/data/mpd/database"
state_file          "/data/mpd/state"
# The state file keeps the phone's volume across restarts; a restored queue must
# not start playing (and wake the speaker) before the receiver clears it.
restore_paused      "yes"
bind_to_address     "127.0.0.1"
port                "6600"
# Host networking: MPD must not announce itself on the LAN.
zeroconf_enabled    "no"
auto_update         "no"

audio_output {
    type        "httpd"
    name        "ytcast stream"
    @STREAM_ENCODER@
    port        "8000"
    # The speaker needs one connection; a few more for reconnects, no more.
    max_clients "4"
    # 16-bit also for FLAC: the Raumfeld connects to a 24-bit FLAC stream but
    # never plays it. A fixed rate, not "*": when the output's sample rate
    # changes (a 44.1 kHz song after a 48 kHz one), httpd closes every client,
    # so the speaker would lose the stream between songs.
    format      "48000:16:2"
    # Keep the stream open between tracks and while paused (silence), so the
    # speaker neither drops it nor stalls during the adapter's start gate.
    always_on   "yes"
    tags        "yes"
    # Volume from the phone is MPD's software volume; the speaker's own volume
    # is never touched.
    mixer_type  "software"
}
