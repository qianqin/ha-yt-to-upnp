#!/command/with-contenv bashio
# shellcheck shell=bash
# Raumfeld adapter: follows MPD and plays its stream on the configured room.
# shellcheck source=SCRIPTDIR/../../../../usr/lib/ytcast/common.sh
source /usr/lib/ytcast/common.sh
set -e

if ytcast_has_option stream_host; then
    stream_host="$(ytcast_option stream_host)"
else
    stream_host="$(ytcast_lan_ipv4)" || bashio::exit.nok "Cannot detect the LAN IPv4 address; set stream_host"
fi
stream_url="http://${stream_host}:8000/stream.mp3"

# Plain assignments, so that set -e stops on a missing option.
room_udn="$(ytcast_option raumfeld_room_udn)"
speaker_udn="$(ytcast_option raumfeld_speaker_udn)"
log_level="$(ytcast_log_level python)"
env=(
    PATH=/usr/bin:/bin HOME=/nonexistent
    RAUMFELD_ROOM_UDN="${room_udn}" RAUMFELD_SPEAKER_UDN="${speaker_udn}"
    STREAM_URL="${stream_url}"
    MPD_HOST="${YTCAST_MPD_HOST}" MPD_PORT="${YTCAST_MPD_PORT}"
    LOG_LEVEL="${log_level}"
)
# Unset options keep the adapter's own defaults.
if ytcast_has_option start_gate_seconds; then
    start_gate_seconds="$(ytcast_option start_gate_seconds)"
    env+=(START_GATE_SECONDS="${start_gate_seconds}")
fi
if ytcast_has_option stuck_seconds; then
    stuck_seconds="$(ytcast_option stuck_seconds)"
    env+=(STUCK_SECONDS="${stuck_seconds}")
fi

ytcast_wait_for_mpd
bashio::log.info "Starting Raumfeld adapter (stream ${stream_url})"
exec s6-setuidgid adapter env -i "${env[@]}" python3 -I /opt/ytcast-adapter/raumfeld_adapter.py
