#!/command/with-contenv bashio
# shellcheck shell=bash
# Every service starts with an empty environment: the container's (with the
# Supervisor token) is not passed on.
# shellcheck source=SCRIPTDIR/../../../../usr/lib/ytcast/common.sh
source /usr/lib/ytcast/common.sh
set -e

stream_format="$(ytcast_option stream_format)"
bashio::log.info "Starting MPD (control 127.0.0.1:6600, ${stream_format} stream on port 8000)"
exec s6-setuidgid mpd env -i PATH=/usr/bin:/bin HOME=/nonexistent \
    mpd --no-daemon --stderr "${YTCAST_MPD_CONF}"
