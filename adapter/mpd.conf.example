# Minimal MPD configuration for the receiver + Raumfeld adapter.
# The receiver plays into MPD; MPD re-serves the audio as an HTTP stream that
# the Raumfeld zone renderer fetches. Paths are placeholders.

music_directory     "/path/to/music"
db_file             "/path/to/mpd/database"
state_file          "/path/to/mpd/state"
bind_to_address     "localhost"
port                "6600"

audio_output {
    type        "httpd"
    name        "Raumfeld stream"
    encoder     "wave"          # WAV -> STREAM_URL=http://<receiver-host>:8000/stream.wav, STREAM_MIME=audio/wav
    port        "8000"
    # Fixed 48 kHz (Opus's own rate; 44.1 kHz AAC is resampled): with the
    # source's own rate ("*:16:2"), MPD's httpd output closes its clients
    # whenever the rate changes between songs, and the speaker drops the stream.
    format      "48000:16:2"
    always_on   "yes"           # keep the stream open between tracks and while paused; WAV and
                                # MP3 carry silence while paused, so the speaker can start
                                # during the start gate (FLAC sends nothing then: slow starts)
    tags        "yes"
    # The phone's volume is just a number in MPD (httpd has no mixer, so without a
    # mixer_type setvol fails with "No mixer"); "null" leaves the samples alone. The
    # adapter follows it to the Raumfeld's own volume, scaled to MAX_VOLUME.
    mixer_type  "null"
}

# MP3 variant (instead of encoder "wave" above, ~320 kbit/s instead of ~1.5 Mbit/s;
# STREAM_URL=http://<receiver-host>:8000/stream.mp3, STREAM_MIME=audio/mpeg):
#     encoder     "lame"
#     bitrate     "320"

# FLAC variant (use instead of the block above; STREAM_URL=http://<receiver-host>:8000/stream.flac,
# STREAM_MIME=audio/flac). Slow to start and resume: while MPD is paused (the start
# gate) a FLAC stream carries no data, so the speaker only starts once the gate gives up.
# Keep it 16-bit: a Raumfeld connects to a 24-bit FLAC stream but never plays it.
# audio_output {
#     type        "httpd"
#     name        "Raumfeld stream (FLAC)"
#     encoder     "flac"
#     compression "5"
#     port        "8000"
#     format      "48000:16:2"   # fixed 48 kHz as above
#     always_on   "yes"
#     mixer_type  "null"       # phone volume -> Raumfeld volume (adapter), samples untouched
# }
